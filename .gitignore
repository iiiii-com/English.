# 依赖与构建产物
node_modules/
package-lock.json

# 临时文件
*.log
.DS_Store
Thumbs.db

# 本地数据备份（不应进仓库）
*.json.bak
_backup/

# ---- 在线发音服务 ----
# 音频缓存是运行时产物，可能几十上百 MB，且可随时重建
tools/.tts-cache/

# ---- Android 构建相关 ----
# Gradle / Android SDK 路径与构建缓存
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/web/
.gradle/

# 签名密钥：绝不能进仓库
*.keystore
*.jks

# 构建产物
android/app-release.apk
android/app-release.aab
# 旧版本残留的安装包（4.9M，不该进仓库）
android/*.apk