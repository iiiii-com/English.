<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置
  ============================================================
  默认全站禁止明文 HTTP（android:usesCleartextTraffic="false" 的等价物，
  但这个文件能精确到域名，比一刀切更可控）。

  这里只对「本机回环地址」放开明文：
    - 127.0.0.1 / localhost：开发与局域网调试时，网页侧的在线发音代理
      （tools/tts-server.js）跑在这两个地址上。App 的 WebView 要能取到
      http://127.0.0.1:8788/tts 的音频，明文必须允许，否则发音会静默失败。
    - 10.0.2.2：Android 模拟器访问宿主机 localhost 的固定别名。

  正式部署时，走 HTTPS 的代理地址不受此文件限制，无需改动。
  其他所有域名仍然禁止明文，登录与进度同步的加密要求不被削弱。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Android 模拟器访问宿主机 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>